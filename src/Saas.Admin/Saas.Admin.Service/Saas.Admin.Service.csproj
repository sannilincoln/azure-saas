<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>aspnet-Saas.Admin.Service-5358E0C3-EA51-44EA-B381-CA2F9D9710D3</UserSecretsId>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<IncludeOpenAPIAnalyzers>true</IncludeOpenAPIAnalyzers>
		<Configurations>Debug;Release;Multi Debug</Configurations>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.0" />
		<PackageReference Include="Dawn.Guard" Version="1.12.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" Version="7.0.0" />
		<!-- Marketplace.SaaS.Client 2.2.0 needs Roslyn 4.14+; EF Design pins Workspaces (and Common)
		     to 4.5.0. Reference the higher CSharp AND Common directly so a clean restore unifies the
		     transitive graph (NU1107) — pinning CSharp alone leaves Common 4.5.0-vs-4.14.0 conflicting
		     on stricter NuGet resolvers (the ADO hosted agent's). -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.14.0" />
		<!-- Marketplace.SaaS.Client 2.2.0 needs System.Text.Json >= 9.0.6, while Microsoft.Graph's
		     Kiota chain caps it at < 9.0.0. Pin 9.0.6 directly so a strict restore (ADO agent) unifies
		     the graph instead of failing NU1107; the app already runs on 9.0.6. -->
		<PackageReference Include="System.Text.Json" Version="9.0.6" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.6" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.6">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>$(AssemblyName).Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\..\Saas.Identity\Saas.Permissions\Saas.Permissions.Client\Saas.Permissions.Client.csproj" />
	  <ProjectReference Include="..\..\Saas.Lib\Saas.Identity\Saas.Identity.csproj" />
	  <ProjectReference Include="..\..\Saas.Lib\Saas.Shared\Saas.Shared.csproj" />
	  <ProjectReference Include="..\..\Saas.Marketplace\DataAccess\DataAccess.csproj" />
	  <ProjectReference Include="..\..\Saas.Marketplace\Services\Services.csproj" />
	</ItemGroup>
</Project>
