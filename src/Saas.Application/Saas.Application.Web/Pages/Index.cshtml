@page "{route?}"
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
}

@if (Model.DisplayTenantInfo)
{
    @* SWAP-IN SEAM: this branch runs for a real tenant, identified by the {route} segment and
       resolved via ITenantService -> Admin API tenantinfo/{route}. Replace the placeholder below
       with your product's authenticated, per-tenant home page (or redirect to it). The resolved
       TenantViewModel (Id, Name, SubscriptionStatus) is the only contract this template provides. *@

    <h1>@(Model.tenantData?.Name ?? "Your workspace")</h1>
    <p>You are signed in to tenant <strong>@(Model.tenantData?.Name ?? "Unknown")</strong>.</p>
    <p class="text-muted">Tenant ID: @(Model.tenantData?.Id.ToString() ?? "Unknown")</p>
    <p class="text-muted">This is the per-tenant home of the product app shell. Build your product here.</p>
}
else
{
    @* SWAP-IN SEAM: this branch is the unauthenticated / no-tenant landing. Replace it with your
       product's marketing or sign-in landing page. *@

    <div class="container">
        <section class="row mb-5 pb-md-4">
            <div class="col-md-8">
                <h2 class="display-5 fw-normal">Your SaaS product</h2>
                <p>
                    This is the reusable product-app shell. It resolves a tenant from the URL route,
                    enforces the Azure Marketplace subscription status, and hands off to your product.
                </p>
                <p class="text-muted">
                    Replace this page (and <code>Pages/Index.cshtml</code> / <code>Pages/Shared/_Layout.cshtml</code>)
                    with your product UI. Keep the <code>route &rarr; ITenantService &rarr; tenantinfo/{route}</code>
                    seam and the <code>RequireActiveSubscription</code> middleware. See <code>README.md</code>.
                </p>
            </div>
        </section>
    </div>
}
