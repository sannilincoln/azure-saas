@model NotificationSettings

@{
    ViewData["Title"] = "Notification Settings (Publisher)";
}

<h1>Notification Settings</h1>
<p class="text-muted">Which emails the platform sends, and who receives the sign-up alert. The sending mailbox is managed in configuration.</p>

@if (TempData["SettingsSaved"] is true)
{
    <div class="alert alert-success">Settings saved.</div>
}

@if (TempData["TestEmailMessage"] is string testEmailMessage)
{
    <div class="alert @(TempData["TestEmailOk"] is true ? "alert-success" : "alert-danger")">@testEmailMessage</div>
}

<form asp-area="Publisher" asp-controller="Settings" asp-action="Index" method="post" style="max-width:640px">
    @Html.AntiForgeryToken()

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="Enabled" value="true" id="Enabled" @(Model.Enabled ? "checked" : "") />
        <input type="hidden" name="Enabled" value="false" />
        <label class="form-check-label" for="Enabled"><strong>Enable email notifications</strong> (master switch)</label>
    </div>

    <fieldset class="mb-3 ps-3 border-start">
        <legend class="form-label">Send which emails</legend>

        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="SignupAlert" value="true" id="SignupAlert" @(Model.SignupAlert ? "checked" : "") />
            <input type="hidden" name="SignupAlert" value="false" />
            <label class="form-check-label" for="SignupAlert">Alert us when a new tenant signs up</label>
        </div>

        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="Welcome" value="true" id="Welcome" @(Model.Welcome ? "checked" : "") />
            <input type="hidden" name="Welcome" value="false" />
            <label class="form-check-label" for="Welcome">Welcome the new tenant by email</label>
        </div>

        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="Invite" value="true" id="Invite" @(Model.Invite ? "checked" : "") />
            <input type="hidden" name="Invite" value="false" />
            <label class="form-check-label" for="Invite">Email invited users</label>
        </div>

        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="RoleChange" value="true" id="RoleChange" @(Model.RoleChange ? "checked" : "") />
            <input type="hidden" name="RoleChange" value="false" />
            <label class="form-check-label" for="RoleChange">Notify members when their role changes</label>
        </div>
    </fieldset>

    <div class="mb-3">
        <label class="form-label" for="ToEmails">Sign-up alert recipient(s)</label>
        <input class="form-control" type="text" name="ToEmails" id="ToEmails" value="@Model.ToEmails" placeholder="ops@yourdomain.com; sales@yourdomain.com" />
        <div class="form-text">Where the "new tenant signed up" alert is sent. Separate multiple addresses with a semicolon or comma.</div>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" asp-area="Publisher" asp-controller="Subscriptions" asp-action="Index">Back to subscriptions</a>
</form>

<hr class="my-4" style="max-width:640px" />

<form asp-area="Publisher" asp-controller="Settings" asp-action="TestEmail" method="post" style="max-width:640px">
    @Html.AntiForgeryToken()
    <label class="form-label" for="TestEmailTo"><strong>Send a test email</strong></label>
    <div class="input-group">
        <input class="form-control" type="email" name="to" id="TestEmailTo" placeholder="you@yourdomain.com" required />
        <button type="submit" class="btn btn-outline-primary">Send test email</button>
    </div>
    <div class="form-text">Sends a one-off email via the configured mailbox to confirm the Graph transport is working. Independent of the toggles above.</div>
</form>
