@model IReadOnlyList<SubscriptionInfo>

@{
    ViewData["Title"] = "Subscriptions (Publisher)";
}

<h1>Marketplace Subscriptions</h1>
<p class="text-muted">All customer subscriptions for this product.</p>

@if (Model.Count == 0)
{
    <p>No subscriptions yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Subscription</th>
                <th>Customer</th>
                <th>Plan</th>
                <th>Seats</th>
                <th>Status</th>
                <th>Tenant</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name<br /><small class="text-muted">@item.SubscriptionId</small></td>
                <td>@item.PurchaserEmail<br /><small class="text-muted">@item.CustomerTenantId</small></td>
                <td>@item.PlanId</td>
                <td>@item.Quantity</td>
                <td>@item.Status</td>
                <td>@(item.TenantName ?? "—")</td>
                <td>
                    <form asp-area="Publisher" asp-controller="Subscriptions" asp-action="Refresh" asp-route-id="@item.SubscriptionId" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Refresh</button>
                    </form>
                    <form asp-area="Publisher" asp-controller="Subscriptions" asp-action="OverrideStatus" asp-route-id="@item.SubscriptionId" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <select name="status" class="form-select form-select-sm" style="display:inline;width:auto">
                            <option value="Subscribed">Subscribed</option>
                            <option value="Suspended">Suspended</option>
                            <option value="Unsubscribed">Unsubscribed</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-danger">Override</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
